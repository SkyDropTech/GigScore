# GigScore Environment Configuration Example
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/focusdesk?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/focusdesk?retryWrites=true&w=majority
MONGODB_DB_NAME=focusdesk
SECRET_KEY=gigscore_super_secret_jwt_key_2026_production_grade
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary PDF & Document Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Render Keep-Alive & UptimeRobot Bot Configuration
# Prevents Render free tier instances from sleeping after 15 minutes of inactivity
ENABLE_SELF_PING=true
SELF_PING_INTERVAL_MINUTES=10
# Optional: Enter your UptimeRobot API key (from https://dashboard.uptimerobot.com/my/api)
# The backend will automatically create or verify the HTTP keep-alive monitor on startup!
UPTIMEROBOT_API_KEY=
